node_modules/
dist/
*.log
measurements/
.DS_Store
.env
.idea/
.worktrees/

# Obsidian. NO leading slash: a vault opened on a SUBFOLDER writes its config
# there, so `/.obsidian/` would match the repo root only.
#
# `.trash/` is the one that matters — it holds notes Obsidian has deleted, and
# committing it publishes content someone chose to remove.
.obsidian/
.trash/
.obsidian.vimrc
*.canvas

# Per-tree, never shared. Two agents each run a clone of this repo
# (~/dev/chat-mcp is claude1's, ~/dev/chat-mcp2 is claude2's) and `.mcp.json`
# is what binds a clone to ONE bus handle. Committing it would give both
# clones the same handle, and the shim refuses the second one outright.
#
# ⚠️ NOT a blanket `.claude/*` ignore, unlike `leagues`. This repo TRACKS
# `.claude/agents/` on purpose — those reviewers are about THIS codebase.
# Per-machine permission files and one person's workflow skill are ignored.
/.mcp.json
/.claude/settings.json
/.claude/settings.local.json

# 🛑 ONE PERSON'S WORKFLOW, NOT THIS PROJECT'S. `local-context` is a per-task
# working-memory skill keyed to one operator's habits, and its mount key showed
# up in the docs as if `/mnt/local-context` were a standard container path. The
# MOUNT mechanism is already generic — `mountsFor` reads whatever keys
# `mounts.json` holds and `src/` never names this one.
#
# ⚠️ AN IGNORED FILE IS STILL DESTROYED BY `git clean -xfd`, so the canonical
# copy lives OUTSIDE every checkout, at `~/.claude/skills/local-context/`.
/.claude/skills/local-context/

# Created by the Claude Code Agent tool at runtime. It is scratch, and a
# `git add -A` once swept a skill for an UNRELATED codebase into a merged PR.
.agents/
